/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model uso_promocao {
  id              String   @id @db.Char(36)
  promocao_id     String   @db.Char(36)
  usuario_id      String   @db.Char(36)
  aposta_id       String?  @db.Char(36)
  bonus_creditado Decimal  @default(0.00) @db.Decimal(18, 2)
  utilizado_em    DateTime @default(now())

  @@index([aposta_id], map: "idx_uso_promocao_aposta")
  @@index([promocao_id, usuario_id], map: "idx_uso_promocao_limites")
  @@index([usuario_id, utilizado_em], map: "idx_uso_promocao_usuario")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model usuario {
  id                  String         @id @db.Char(36)
  nome                String         @db.VarChar(120)
  email               String         @unique(map: "uq_usuario_email") @db.VarChar(255)
  senha_hash          String         @db.VarChar(255)
  papel               usuario_papel  @default(APOSTADOR)
  status              usuario_status @default(ATIVO)
  email_verificado_em DateTime?
  criado_em           DateTime       @default(now())
  atualizado_em       DateTime       @default(now())
  excluido_em         DateTime?

  @@index([papel, status], map: "idx_usuario_papel_status")
}

enum carteira_tipo {
  NORMAL
  BONUS
}

enum mercado_status {
  ABERTO
  SUSPENSO
  FECHADO
}

enum promocao_tipo {
  BONUS_CREDITO
  ODDS_BOOST
}

enum selecao_status {
  ABERTA
  SUSPENSA
  FECHADA
}

enum usuario_papel {
  APOSTADOR
  ADMINISTRADOR
}

enum movimentacao_tipo {
  CREDITO_INICIAL
  RECARGA_SIMULADA
  APOSTA
  PREMIO
  ESTORNO
  BONUS
  AJUSTE_ADMIN
  SAQUE_SIMULADO
  ESTORNO_SAQUE
}

model saque {
  id              String       @id @db.Char(36)
  usuario_id      String       @db.Char(36)
  carteira_id     String       @db.Char(36)
  valor           Decimal      @db.Decimal(18, 2)
  metodo          String       @db.VarChar(60)
  status          saque_status @default(PENDENTE)
  idempotency_key String       @unique @db.Char(36)
  admin_id        String?      @db.Char(36)
  motivo          String?      @db.VarChar(500)
  criado_em       DateTime     @default(now())
  decidido_em     DateTime?

  @@index([usuario_id, criado_em])
  @@index([status, criado_em])
}

enum saque_status {
  PENDENTE
  APROVADO
  RECUSADO
}

enum selecao_resultado {
  PENDENTE
  GANHOU
  PERDEU
  ANULADA
}

enum usuario_status {
  ATIVO
  SUSPENSO
  BLOQUEADO
}

enum aposta_status {
  PENDENTE
  GANHA
  PERDIDA
  ANULADA
}

enum jogo_status {
  AGENDADO
  AO_VIVO
  ENCERRADO
  CANCELADO
}

enum item_aposta_resultado {
  PENDENTE
  GANHOU
  PERDEU
  ANULADA
}

enum promocao_status {
  ATIVA
  PAUSADA
  ENCERRADA
}
